---
import BaseLayout from "@layouts/BaseLayout.astro";
import publications from "@data/publications.json";

const LAB_MEMBERS = publications.labMembers.map(n => n.toLowerCase());

function isLabMember(name) {
  const lower = name.toLowerCase().trim();
  return LAB_MEMBERS.some(m => lower === m || lower.includes(m));
}

function formatAuthors(authors) {
  return authors.map(name => {
    if (isLabMember(name)) {
      return `<strong class="cs-lab">${name}</strong>`;
    }
    return name;
  }).join(', ');
}

// Sort all papers by year descending
const sortedPapers = [...publications.papers].sort((a, b) => b.year - a.year);

// Group by year, merge years <= 2022 into "Before 2023"
const byYear = {};
for (const paper of sortedPapers) {
  const groupKey = paper.year <= 2022 ? 'Before 2023' : paper.year;
  if (!byYear[groupKey]) byYear[groupKey] = [];
  byYear[groupKey].push(paper);
}

// Order: individual years descending, "Before 2023" always last
const years = Object.keys(byYear)
  .map(k => k === 'Before 2023' ? { key: k, num: -1 } : { key: k, num: Number(k) })
  .sort((a, b) => b.num - a.num)
  .map(y => y.key);

const lastUpdated = new Date(publications.fetchedAt).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title="Publications - Intelligent Biomechanics Lab"
  description="Publications from the Intelligent Biomechanics Lab."
>

<section id="publications-page">
  <div class="cs-container">

    <header class="cs-header">
      <h1>Publications</h1>
      <a class="cs-scholar" href="https://scholar.google.com/citations?user=t-lHPeMAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a>
      <p class="cs-updated">{publications.totalPapers} publications · Last updated {lastUpdated}</p>
    </header>

    {years.map(year => (
      <>
        <h3>{year}</h3>
        <ul class="cs-papers">
          {byYear[year].map(paper => {
            const authorsHtml = formatAuthors(paper.authors);
            const paperLink = paper.doi ? `https://doi.org/${paper.doi}` : paper.link;
            const titleTag = paperLink
              ? `<a href="${paperLink}" class="cs-title-link" target="_blank" rel="noopener">${paper.title}</a>`
              : paper.title;
            return (
              <li>
                <strong set:html={titleTag}></strong>.
                <span class="cs-authors" set:html={authorsHtml}></span>.
                <em>{paper.venue}</em>.
              </li>
            );
          })}
        </ul>
      </>
    ))}

  </div>
</section>

</BaseLayout>


<style lang="less">
  @import "../styles/pages/publications.less";
</style>
