---
import BaseLayout from "@layouts/BaseLayout.astro";
import ResearchVideo from "@components/research/ResearchVideo.astro";
import EquipmentGallery from "@components/research/EquipmentGallery.astro";
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";

import videos from "@data/research-videos";

const equipment = JSON.parse(readFileSync(resolve(process.cwd(), "src/data/equipment.json"), "utf8"));
const equipmentItems = equipment.items.map((item) => ({
  ...item,
  hasPhoto: existsSync(resolve(process.cwd(), `public${item.image}`)),
}));
---

<BaseLayout
  title="Research - Intelligent Biomechanics Lab"
  description="Explore our cutting-edge research: HeartSimSage for cardiac mechanics and Stomach Digital Twin for GI motility modeling"
>

<!-- Hero Section -->
<section id="item-hero">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">Research</span>
            <h1 class="cs-title">Funding & Partners</h1>
            <p class="cs-subtitle">Our research is supported by competitive federal grants and strong cross-institutional collaborations.</p>
        </div>

        <!-- Funding & Partners -->
        <div class="fnp-grid">
            <div class="fnp-card fnp-card-nih">
                <img class="fnp-logo-nih" src="/assets/images/funding/nih-logo-white.png" alt="National Institutes of Health" />
            </div>
            <div class="fnp-card fnp-card-nsf">
                <img class="fnp-logo-nsf" src="/assets/images/funding/nsf-logo-official.png" alt="" aria-hidden="true" />
                <span class="fnp-wordmark-nsf">U.S. National Science Foundation</span>
            </div>
            <div class="fnp-card">
                <img src="/assets/images/PartnerInstitutions/ksu-logo-white.svg" alt="Kennesaw State University" loading="lazy" decoding="async" />
            </div>
            <div class="fnp-card">
                <img class="fnp-logo-emory" src="/assets/images/PartnerInstitutions/emory-logo-white.svg" alt="Emory University" loading="lazy" decoding="async" />
            </div>
        </div>
    </div>
</section>

<!-- Research Areas Navigation -->
<section id="research-nav">
    <div class="cs-container">
        <div class="cs-tabs" role="tablist" aria-label="Research areas">
            <button class="cs-tab cs-tab-ml cs-tab-active" data-tab="ml" role="tab" aria-selected="true" aria-controls="ml-content">
                <span class="cs-tab-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                        <path d="M5 7l7-3m-7 3l7 5M5 7l7 13M5 17l7-13m-7 13l7-5m-7 5l7 3M12 4l7 4m-7 4l7-4m-7 4l7 4m-7 8l7-4" opacity="0.55" />
                        <circle cx="5" cy="7" r="2" fill="currentColor" stroke="none" />
                        <circle cx="5" cy="17" r="2" fill="currentColor" stroke="none" />
                        <circle cx="12" cy="4" r="2" fill="currentColor" stroke="none" />
                        <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none" />
                        <circle cx="12" cy="20" r="2" fill="currentColor" stroke="none" />
                        <circle cx="19" cy="8" r="2" fill="currentColor" stroke="none" />
                        <circle cx="19" cy="16" r="2" fill="currentColor" stroke="none" />
                    </svg>
                </span>
                <span class="cs-tab-label">Machine Learning</span>
            </button>
            <button class="cs-tab cs-tab-multiscale" data-tab="multiscale" role="tab" aria-selected="false" aria-controls="multiscale-content">
                <span class="cs-tab-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="10" cy="10" r="6.5" />
                        <path d="M15 15l5.5 5.5" stroke-width="2.4" />
                        <path d="M10 6.8l2.8 1.6v3.2L10 13.2l-2.8-1.6V8.4z" fill="currentColor" fill-opacity="0.35" />
                    </svg>
                </span>
                <span class="cs-tab-label">Multiscale &amp; Multiphysics</span>
            </button>
            <button class="cs-tab cs-tab-constitutive" data-tab="constitutive" role="tab" aria-selected="false" aria-controls="constitutive-content">
                <span class="cs-tab-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 3v17h17" />
                        <path d="M5 19c4-.5 7-2 9-5s3.5-6.5 5-10" stroke-width="2.2" />
                        <circle cx="14" cy="14" r="1.6" fill="currentColor" stroke="none" />
                    </svg>
                </span>
                <span class="cs-tab-label">Constitutive Modeling</span>
            </button>
            <button class="cs-tab cs-tab-experiments" data-tab="experiments" role="tab" aria-selected="false" aria-controls="experiments-content">
                <span class="cs-tab-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 3h6M10 3v6.2L4.6 18.4A1.8 1.8 0 0 0 6.2 21h11.6a1.8 1.8 0 0 0 1.6-2.6L14 9.2V3" />
                        <path d="M7.2 15h9.6l1.6 3.2a.9.9 0 0 1-.8 1.3H6.4a.9.9 0 0 1-.8-1.3z" fill="currentColor" fill-opacity="0.35" stroke="none" />
                    </svg>
                </span>
                <span class="cs-tab-label">Experiments &amp; Testing</span>
            </button>
        </div>
    </div>
</section>

<!-- Research Areas Content -->
<div id="research-content">

<!-- ============================================ -->
<!-- 1. Machine Learning                          -->
<!-- ============================================ -->
<div id="ml-content" class="research-area area-ml project-content project-active" role="tabpanel">
    <div class="cs-container">
        <div class="area-header">
            <div class="area-badge">01</div>
            <div class="area-title-row">
                <h2 class="section-title">Machine Learning</h2>
                <a class="research-lead" href="/members/sanjian/" aria-label="Research lead: Sanjian Zhang. View profile.">
                    <img src="/assets/images/members/sanjian.png" alt="" width="44" height="44" loading="lazy" decoding="async" />
                    <span class="research-lead-info">
                        <span class="research-lead-label">Research Lead</span>
                        <span class="research-lead-name">Sanjian Zhang</span>
                    </span>
                    <svg class="research-lead-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M5 12h14m-6-6 6 6-6 6" />
                    </svg>
                </a>
            </div>
            <p class="section-text">AI-driven simulation accelerators and predictive models that replace expensive finite element solvers with learned surrogate representations.</p>
        </div>

        <!-- Overview -->
        <div class="area-block">
            <h3 class="block-title">Data Analysis &amp; Machine Learning</h3>
            <p class="block-text">We design data pipelines and machine learning models to process experimental and clinical data, classify motility patterns, and accelerate prediction and decision support.</p>
            <p class="block-text">Our machine learning research also explores spatiotemporal modeling of cardiac dynamics. <a href="/members/sanjian/">Sanjian Zhang</a> studies how to integrate cardiac structures reconstructed from CT/MRI with physiological signals, such as blood pressure, and clinical variables to model and predict cardiac motion throughout the cardiac cycle.</p>
        </div>

        <!-- Core Framework -->
        <div class="area-block">
            <h3 class="block-title">HeartSimSage: Attention-Enhanced Graph Neural Networks</h3>
            <p class="block-text">Our flagship ML framework converts cardiac finite element meshes into graph structures, learning the relationship between geometry, material properties, loading conditions, and tissue deformation, at <strong>13,000× GPU acceleration</strong> and <strong>190× CPU acceleration</strong> compared to traditional FEA, with median error under <strong>0.13%</strong>.</p>

            <div class="area-image">
                <img src="/assets/images/item/heartsim.png" alt="HeartSimSage Framework Architecture" loading="lazy" decoding="async" />
            </div>

            <div class="tech-grid">
                <div class="tech-card">
                    <div class="tech-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                        </svg>
                    </div>
                    <h4 class="tech-title">GraphSAGE Topology</h4>
                    <p class="tech-text">Flexible node connectivity on unstructured cardiac meshes.</p>
                </div>
                <div class="tech-card">
                    <div class="tech-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                    </div>
                    <h4 class="tech-title">Laplace-Dirichlet Encoding</h4>
                    <p class="tech-text">Mesh-aware spatial embedding via Laplace equation solutions.</p>
                </div>
                <div class="tech-card">
                    <div class="tech-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                    </div>
                    <h4 class="tech-title">Attention Mechanism</h4>
                    <p class="tech-text">Adaptive message passing with dynamic neighbor weighting.</p>
                </div>
                <div class="tech-card">
                    <div class="tech-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                            <line x1="9" y1="9" x2="15" y2="9"/>
                            <line x1="9" y1="15" x2="14" y2="15"/>
                        </svg>
                    </div>
                    <h4 class="tech-title">Subset Training</h4>
                    <p class="tech-text">Efficient subgraph sampling to reduce memory footprint.</p>
                </div>
            </div>
        </div>

        <!-- Project Visualization -->
        <div class="area-block">
            <h3 class="block-title">Project Visualization</h3>
            <ResearchVideo {...videos.ml} />
        </div>

        <!-- Highlights -->
        <div class="performance-grid">
            <div class="performance-card">
                <div class="performance-value">13,000×</div>
                <div class="performance-label">GPU Acceleration</div>
            </div>
            <div class="performance-card">
                <div class="performance-value">190×</div>
                <div class="performance-label">CPU Acceleration</div>
            </div>
            <div class="performance-card">
                <div class="performance-value">0.13%</div>
                <div class="performance-label">Median Error</div>
            </div>
            <div class="performance-card">
                <div class="performance-value">0.28mm</div>
                <div class="performance-label">Max Displacement Error</div>
            </div>
        </div>

        <!-- Publications -->
        <div class="area-block">
            <h3 class="block-title">Related Publications</h3>
            <ul class="pub-list">
                <li class="pub-item">
                    <strong>Shi L*</strong>, Chen Y, Vedula V. <em>Journal of Computational Physics</em>, 2026. HeartSimSage framework for AI-accelerated cardiac biomechanical simulations.
                </li>
            </ul>
        </div>

        <!-- Interested CTA -->
        <div class="research-interested">
            <div class="interested-left">
                <h3>Interested in This Research?</h3>
                <p>Tell us your major, year, and what caught your eye. We'll reply within a week.</p>
            </div>
            <a href="/contact" class="interested-btn">Contact Dr. Shi</a>
        </div>
    </div>
</div>

<!-- ============================================ -->
<!-- 2. Multiscale & Multiphysics Simulation     -->
<!-- ============================================ -->
<div id="multiscale-content" class="research-area area-multiscale project-content" role="tabpanel">
    <div class="cs-container">
        <div class="area-header">
            <div class="area-badge">02</div>
            <div class="area-title-row">
                <h2 class="section-title">Multiscale &amp; Multiphysics Simulation</h2>
                <a class="research-lead" href="/members/nanlong/" aria-label="Research lead: Nanlong Sun. View profile.">
                    <img src="/assets/images/members/nanlong.jpg" alt="" width="44" height="44" loading="lazy" decoding="async" />
                    <span class="research-lead-info">
                        <span class="research-lead-label">Research Lead</span>
                        <span class="research-lead-name">Nanlong Sun</span>
                    </span>
                    <svg class="research-lead-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M5 12h14m-6-6 6 6-6 6" />
                    </svg>
                </a>
            </div>
            <p class="section-text">Cross-scale computational modeling and coupled multiphysics simulations, from molecular ion channels to whole-organ electromechanics.</p>
        </div>

        <!-- Overview -->
        <div class="area-block">
            <h3 class="block-title">Imaging, Reconstruction &amp; Digital Twins</h3>
            <p class="block-text">We integrate CT scans, endoscopy images, and manometry data from clinical collaborators to build accurate 3D models of the stomach, esophagus, and heart. These models are the geometric foundation for every digital twin we construct.</p>
            <p class="block-text">On top of that geometry, we develop patient-specific digital twins that couple tissue mechanics with electrical activity to simulate how each organ contracts, moves, and responds to disease or surgical intervention.</p>
        </div>

        <!-- Core Framework -->
        <div class="area-block">
            <h3 class="block-title">3D-0D Electromechanical Coupling</h3>
            <p class="block-text">Implicit coupling framework that integrates 0D ion-based electrophysiology models with 3D finite-element solid mechanics, enabling patient-specific simulation of cardiac and gastric motility.</p>

            <div class="area-image">
                <img src="/assets/images/achievements/cardiacdigitaltwin.png" alt="Cardiac Digital Twin Multiscale Modeling" loading="lazy" decoding="async" />
                <p class="area-image-caption"><strong>Figure 1:</strong> Multiscale modeling of a patient-specific cardiac digital twin.</p>
            </div>

            <div class="tech-grid">
                <div class="tech-card">
                    <div class="tech-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
                            <path d="M12 2l9 5v10l-9 5-9-5V7z"/>
                            <path d="M3 7l9 5 9-5M12 12v10"/>
                        </svg>
                    </div>
                    <h4 class="tech-title">3D Solid Mechanics</h4>
                    <p class="tech-text">Nonlinear finite-element mechanics with large deformation kinematics.</p>
                </div>
                <div class="tech-card">
                    <div class="tech-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M2 12h4l2-6 4 12 3-9 2 3h5"/>
                        </svg>
                    </div>
                    <h4 class="tech-title">0D Electrophysiology</h4>
                    <p class="tech-text">Ion-channel models of electrical activity (e.g., Hodgkin-Huxley type).</p>
                </div>
                <div class="tech-card">
                    <div class="tech-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 2l4 4-4 4"/>
                            <path d="M3 11V9a3 3 0 0 1 3-3h15"/>
                            <path d="M7 22l-4-4 4-4"/>
                            <path d="M21 13v2a3 3 0 0 1-3 3H3"/>
                        </svg>
                    </div>
                    <h4 class="tech-title">Mechano-Electric Feedback</h4>
                    <p class="tech-text">Bidirectional coupling between tissue deformation and electrical activity.</p>
                </div>
                <div class="tech-card">
                    <div class="tech-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                            <path d="M3 9h18M9 21V9"/>
                        </svg>
                    </div>
                    <h4 class="tech-title">Implicit Coupling</h4>
                    <p class="tech-text">0D and 3D models solved together within one implicit coupling framework.</p>
                </div>
            </div>
        </div>

        <div class="area-block">
            <h3 class="block-title">4D Patient-Specific Imaging</h3>
            <p class="block-text">Integration of time-phase CT and MRI imaging to construct personalized 3D organ geometries that evolve physiologically throughout the cardiac or respiratory cycle.</p>
            <div class="feature-list">
                <div class="feature-item"><span>Segment</span> Multi-atlas + deep-learning organ segmentation</div>
                <div class="feature-item"><span>Morph</span> Non-rigid registration for motion estimation</div>
                <div class="feature-item"><span>Mesh</span> Hex-dominant discretization with quality control</div>
            </div>
        </div>

        <!-- Project Visualization -->
        <div class="area-block">
            <h3 class="block-title">Project Visualization</h3>
            <ResearchVideo {...videos.multiscale} />
        </div>

        <!-- Applications -->
        <div class="area-block">
            <h3 class="block-title">Applications</h3>
            <div class="applications-list">
                <div class="application-item">
                    <span class="application-number">01</span>
                    <div class="application-content">
                        <h4 class="application-title">Personalized Diagnosis</h4>
                        <p class="application-text">Patient-specific mechanical predictions for improved clinical accuracy.</p>
                    </div>
                </div>
                <div class="application-item">
                    <span class="application-number">02</span>
                    <div class="application-content">
                        <h4 class="application-title">Surgical Planning</h4>
                        <p class="application-text">Pre-operative biomechanical simulation of bariatric and GI procedures.</p>
                    </div>
                </div>
                <div class="application-item">
                    <span class="application-number">03</span>
                    <div class="application-content">
                        <h4 class="application-title">Gastric Pacemaker Design</h4>
                        <p class="application-text">Optimizing electrode placement for electrical stimulation devices.</p>
                    </div>
                </div>
                <div class="application-item">
                    <span class="application-number">04</span>
                    <div class="application-content">
                        <h4 class="application-title">Population-Scale Studies</h4>
                        <p class="application-text">Efficient computation enabling large-cohort biomechanical research.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Publications -->
        <div class="area-block">
            <h3 class="block-title">Related Publications</h3>
            <ul class="pub-list">
                <li class="pub-item">
                    <strong>Shi L*</strong>, Chen IY, Vedula V. <em>Computer Methods in Applied Mechanics and Engineering</em>, 2026. Personalized multiscale modeling of left atrial mechanics and blood flow.
                </li>
                <li class="pub-item">
                    Vedula V, <strong>Shi L</strong>, Gan BB. APS Division of Fluid Dynamics, 2024. Multiscale electromechanics modeling framework.
                </li>
            </ul>
        </div>

        <!-- Interested CTA -->
        <div class="research-interested">
            <div class="interested-left">
                <h3>Interested in This Research?</h3>
                <p>Tell us your major, year, and what caught your eye. We'll reply within a week.</p>
            </div>
            <a href="/contact" class="interested-btn">Contact Dr. Shi</a>
        </div>
    </div>
</div>

<!-- ============================================ -->
<!-- 3. Constitutive Modeling                    -->
<!-- ============================================ -->
<div id="constitutive-content" class="research-area area-constitutive project-content" role="tabpanel">
    <div class="cs-container">
        <div class="area-header">
            <div class="area-badge">03</div>
            <div class="area-title-row">
                <h2 class="section-title">Constitutive Modeling</h2>
                <a class="research-lead" href="/members/yue/" aria-label="Research lead: Yue Li. View profile.">
                    <img src="/assets/images/members/lydia.png" alt="" width="44" height="44" loading="lazy" decoding="async" />
                    <span class="research-lead-info">
                        <span class="research-lead-label">Research Lead</span>
                        <span class="research-lead-name">Yue Li</span>
                    </span>
                    <svg class="research-lead-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M5 12h14m-6-6 6 6-6 6" />
                    </svg>
                </a>
            </div>
            <p class="section-text">Physics-based material models that capture the complex, nonlinear behavior of biological soft tissues under large deformation.</p>
        </div>

        <!-- Overview -->
        <div class="area-block">
            <h3 class="block-title">Why Material Models Matter</h3>
            <p class="block-text">Every simulation we run depends on how accurately it describes the tissue itself. Stomach, cardiac, and other soft tissues show both elastic recoil and time-dependent relaxation, so our models are calibrated against the mechanical tests performed in our lab.</p>
        </div>

        <!-- Core Framework -->
        <div class="area-block">
            <h3 class="block-title">Hyper-Viscoelastic Constitutive Framework</h3>
            <p class="block-text">We develop microstructure-informed material models that combine hyperelastic equilibrium response with viscoelastic rate-dependent behavior, which is essential for accurate simulation of soft tissues that exhibit both elastic recoil and time-dependent relaxation.</p>

            <div class="area-image">
                <img src="/assets/images/achievements/computationalbiomechanics.jpg" alt="Computational Biomechanics" loading="lazy" decoding="async" />
                <p class="area-image-caption"><strong>Figure 1:</strong> Computational biomechanics modeling of soft tissue.</p>
            </div>

            <div class="tech-grid">
                <div class="tech-card">
                    <div class="tech-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 12c0 0 3-6 9-6s9 6 9 6-3 6-9 6-9-6-9-6z"/>
                        </svg>
                    </div>
                    <h4 class="tech-title">Microstructure-Informed</h4>
                    <p class="tech-text">Material parameters tied to collagen fiber architecture and ground substance properties.</p>
                </div>
                <div class="tech-card">
                    <div class="tech-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 12h16M4 12l4-4m-4 4l4 4M20 12l-4-4m4 4l-4 4"/>
                        </svg>
                    </div>
                    <h4 class="tech-title">Large Deformation</h4>
                    <p class="tech-text">Validated across physiological strain ranges (up to 40–60%) with anisotropic fiber reinforcement.</p>
                </div>
                <div class="tech-card">
                    <div class="tech-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 6v6l4 2"/>
                        </svg>
                    </div>
                    <h4 class="tech-title">Viscoelastic Coupling</h4>
                    <p class="tech-text">Prony-series based time-dependent response with separable hyperelastic equilibrium.</p>
                </div>
                <div class="tech-card">
                    <div class="tech-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2v20M2 12h20"/>
                        </svg>
                    </div>
                    <h4 class="tech-title">Cross-Validation</h4>
                    <p class="tech-text">Identified via inverse calibration against biaxial, uniaxial, and shear experimental data.</p>
                </div>
            </div>
        </div>

        <!-- Project Visualization -->
        <div class="area-block">
            <h3 class="block-title">Project Visualization</h3>
            <ResearchVideo {...videos.constitutive} />
        </div>

        <!-- Publications -->
        <div class="area-block">
            <h3 class="block-title">Related Publications</h3>
            <ul class="pub-list">
                <li class="pub-item">
                    <strong>Shi L*</strong>, Myers K. <em>Journal of the Mechanics and Physics of Solids</em>, 2026. Microstructure-informed hyper-viscoelastic model for gastric tissue.
                </li>
            </ul>
        </div>

        <!-- Interested CTA -->
        <div class="research-interested">
            <div class="interested-left">
                <h3>Interested in This Research?</h3>
                <p>Tell us your major, year, and what caught your eye. We'll reply within a week.</p>
            </div>
            <a href="/contact" class="interested-btn">Contact Dr. Shi</a>
        </div>
    </div>
</div>

<!-- ============================================ -->
<!-- 4. Equipment & Experimental Collaboration    -->
<!-- ============================================ -->
<div id="experiments-content" class="research-area area-experiments project-content" role="tabpanel">
    <div class="cs-container">
        <div class="area-header">
            <div class="area-title-row">
                <h2 class="section-title">Experiments &amp; Testing</h2>
                <div class="research-leads">
