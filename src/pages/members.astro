---
import BaseLayout from "@layouts/BaseLayout.astro";

import { firstYearCohorts, visitingScholars } from "@data/team";

const firstYearScholarCount = firstYearCohorts.reduce(
  (total, cohort) => total + cohort.students.length,
  0,
);
---

<BaseLayout
  title="Intelligent Biomechanics Lab - Team"
  description="Meet the researchers and students of the Intelligent Biomechanics Lab at Kennesaw State University."
>

<!-- ============================================ -->
<!--                Meet The Team                 -->
<!-- ============================================ -->

<section id="meet-team-1435">
    <div class="cs-container">
        <!-- Background Gradient -->
        <div class="cs-background-gradient"></div>
        
        <!-- Grid Background -->
        <div class="cs-grid-background"></div>
        
        <!-- Header Decorations -->
        <div class="cs-header-decoration">
            <div class="cs-decoration-circle cs-circle-1"></div>
            <div class="cs-decoration-circle cs-circle-2"></div>
            <div class="cs-decoration-circle cs-circle-3"></div>
            <div class="cs-decoration-circle cs-circle-4"></div>
            <div class="cs-decoration-circle cs-circle-5"></div>
            <div class="cs-decoration-star cs-star-1">⭐</div>
            <div class="cs-decoration-star cs-star-2">🌟</div>
            <div class="cs-decoration-star cs-star-3">✨</div>
            <div class="cs-decoration-square cs-square-1"></div>
            <div class="cs-decoration-square cs-square-2"></div>
            <div class="cs-decoration-triangle cs-triangle-1"></div>
            <div class="cs-decoration-triangle cs-triangle-2"></div>
        </div>
        
        <div class="cs-content">
            <h2 class="cs-title">
                <span class="cs-title-gradient">Expert</span> Researchers & Scholars
            </h2>
            <p class="cs-text">Meet the brilliant minds behind the Intelligent Biomechanics Lab, an interdisciplinary team dedicated to advancing GI mechanics, building digital twins, and transforming data into groundbreaking insights.</p>
            <div class="cs-stats-row">
                <div class="cs-stat-item cs-stat-primary">
                    <div class="cs-stat-icon">👨‍🔬</div>
                    <span class="cs-stat-number">1</span>
                    <span class="cs-stat-label">Principal Investigator</span>
                </div>
                <div class="cs-stat-item cs-stat-secondary">
                    <div class="cs-stat-icon">🎓</div>
                    <span class="cs-stat-number">4</span>
                    <span class="cs-stat-label">Ph.D. Researchers</span>
                </div>
                <div class="cs-stat-item cs-stat-tertiary">
                    <div class="cs-stat-icon">🧑‍🎓</div>
                    <span class="cs-stat-number">4</span>
                    <span class="cs-stat-label">Student Researchers</span>
                </div>
                <div class="cs-stat-item cs-stat-scholars">
                    <div class="cs-stat-icon">🎓</div>
                    <span class="cs-stat-number">{firstYearScholarCount}</span>
                    <span class="cs-stat-label">First-Year Scholars</span>
                </div>
            </div>
        </div>

        <!-- Professor Section -->
        <div class="cs-category-section">
            <div class="cs-category-header">
                <div class="cs-category-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <h3 class="cs-category-title">Principal Investigator</h3>
                <div class="cs-category-divider"></div>
            </div>
            <ul class="cs-card-group cs-card-group-professor">
                <li class="cs-item">
                    <picture class="cs-picture">
                        <source media="(max-width: 600px)" srcset="/assets/images/members/shi.png">
                        <source media="(min-width: 601px)" srcset="/assets/images/members/shi.png">
                        <img loading="lazy" decoding="async" src="/assets/images/members/shi.png" alt="Dr. Lei Shi" width="305" height="338">
                    </picture>
                    <div class="cs-info">
                        <span class="cs-name">Lei Shi</span>
                        <span class="cs-job">Assistant Professor</span>
                        <span class="cs-interests">Soft Tissue Digital Twins · FEA · PINNs</span>
                        <a class="cs-bio-button" href="/members/shi">View Profile</a>
                    </div>
                </li>
            </ul>
        </div>

        <!-- PhD Section -->
        <div class="cs-category-section">
            <div class="cs-category-header">
                <div class="cs-category-icon cs-icon-phd">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                        <path d="M2 17l10 5 10-5"></path>
                        <path d="M2 12l10 5 10-5"></path>
                    </svg>
                </div>
                <h3 class="cs-category-title">Ph.D. Researchers</h3>
                <div class="cs-category-divider"></div>
            </div>
            <ul class="cs-card-group">
                <li class="cs-item">
                    <picture class="cs-picture">
                        <source media="(max-width: 600px)" srcset="/assets/images/members/lydia.png">
                        <source media="(min-width: 601px)" srcset="/assets/images/members/lydia.png">
                        <img loading="lazy" decoding="async" src="/assets/images/members/lydia.png" alt="Yue Li" width="305" height="338">
                    </picture>
                    <div class="cs-info">
                        <span class="cs-name">Yue Li</span>
                        <span class="cs-job">Ph.D. Student</span>
                        <span class="cs-interests">Cardiac Biomechanics · Generative AI · NLP</span>
                        <a class="cs-bio-button" href="/members/yue">View Profile</a>
                    </div>
                </li>
                <li class="cs-item">
                    <picture class="cs-picture">
                        <source media="(max-width: 600px)" srcset="/assets/images/members/nanlong.jpg">
                        <source media="(min-width: 601px)" srcset="/assets/images/members/nanlong.jpg">
                        <img loading="lazy" decoding="async" src="/assets/images/members/nanlong.jpg" alt="Nanlong Sun" width="305" height="338">
                    </picture>
                    <div class="cs-info">
                        <span class="cs-name">Nanlong Sun</span>
                        <span class="cs-job">Ph.D. Student</span>
                        <span class="cs-interests">Thin-Film Optimization · LNP · COMSOL</span>
                        <a class="cs-bio-button" href="/members/nanlong">View Profile</a>
                    </div>
                </li>
                <li class="cs-item">
                    <picture class="cs-picture">
                        <source media="(max-width: 600px)" srcset="/assets/images/members/sanjian.png">
                        <source media="(min-width: 601px)" srcset="/assets/images/members/sanjian.png">
                        <img loading="lazy" decoding="async" src="/assets/images/members/sanjian.png" alt="Sanjian Zhang" width="305" height="338">
                    </picture>
                    <div class="cs-info">
                        <span class="cs-name">Sanjian Zhang</span>
                        <span class="cs-job">Ph.D. Student</span>
                        <span class="cs-interests">Cardiac Digital Twins · ML</span>
                        <a class="cs-bio-button" href="/members/sanjian">View Profile</a>
                    </div>
                </li>
                <li class="cs-item cs-item-incoming">
                    <span class="cs-incoming-badge">Incoming</span>
                    <div class="cs-picture cs-picture-placeholder" role="img" aria-label="Zihan Xue">
                        <span class="cs-initials">ZX</span>
                    </div>
                    <div class="cs-info">
                        <span class="cs-name">Zihan Xue</span>
                        <span class="cs-job">Incoming Ph.D. Student</span>
                        <span class="cs-interests">Profile coming soon</span>
                    </div>
                </li>
            </ul>
        </div>

        <!-- Student Researchers Section -->
        <div class="cs-category-section cs-section-student">
            <div class="cs-category-header">
                <div class="cs-category-icon cs-icon-student">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                        <path d="M2 17l10 5 10-5"></path>
                        <path d="M2 12l10 5 10-5"></path>
                    </svg>
                </div>
                <h3 class="cs-category-title">Student Researchers</h3>
                <div class="cs-category-divider"></div>
            </div>
            <ul class="cs-card-group cs-card-group-student">
                <li class="cs-item cs-item-student">
                    <picture class="cs-picture">
                        <source media="(max-width: 600px)" srcset="/assets/images/members/michael.png">
                        <source media="(min-width: 601px)" srcset="/assets/images/members/michael.png">
                        <img loading="lazy" decoding="async" src="/assets/images/members/michael.png" alt="Michael Duong" width="305" height="338">
                    </picture>
                    <div class="cs-info">
                        <span class="cs-name">Michael Duong</span>
                        <span class="cs-edu-tag">Undergraduate</span>
                        <a class="cs-bio-button" href="/members/michael">View Profile</a>
                    </div>
                </li>
                <li class="cs-item cs-item-student">
                    <picture class="cs-picture">
                        <source media="(max-width: 600px)" srcset="/assets/images/members/curtis.png">
                        <source media="(min-width: 601px)" srcset="/assets/images/members/curtis.png">
                        <img loading="lazy" decoding="async" src="/assets/images/members/curtis.png" alt="Curtis Ledford" width="305" height="338">
                    </picture>
                    <div class="cs-info">
                        <span class="cs-name">Curtis Ledford</span>
                        <span class="cs-edu-tag">Undergraduate</span>
                        <a class="cs-bio-button" href="/members/curtis">View Profile</a>
                    </div>
                </li>
                <li class="cs-item cs-item-student">
                    <picture class="cs-picture">
                        <source media="(max-width: 600px)" srcset="/assets/images/members/jonathan.jpg">
                        <source media="(min-width: 601px)" srcset="/assets/images/members/jonathan.jpg">
                        <img loading="lazy" decoding="async" src="/assets/images/members/jonathan.jpg" alt="Jonathan Naddaf" style="object-position: left center;" width="305" height="338">
                    </picture>
                    <div class="cs-info">
                        <span class="cs-name">Jonathan Naddaf</span>
                        <span class="cs-edu-tag">High School</span>
                        <a class="cs-bio-button" href="/members/jonathan">View Profile</a>
                    </div>
                </li>
                <li class="cs-item cs-item-student">
                    <div class="cs-picture cs-picture-placeholder" role="img" aria-label="Manish Raut — photo coming soon">
                        <span class="cs-initials" aria-hidden="true">MR</span>
                    </div>
                    <div class="cs-info">
                        <span class="cs-name">Manish Raut</span>
                        <span class="cs-edu-tag">Student Researcher</span>
                        <span class="cs-interests">Profile coming soon</span>
                    </div>
                </li>
            </ul>
        </div>

        <!-- First-Year Scholars Section -->
        <section class="cs-category-section" id="first-year-scholars" aria-labelledby="first-year-scholars-title">
            <div class="cs-category-header cs-scholars-header">
                <div class="cs-category-icon cs-icon-scholars">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                    </svg>
                </div>
                <h3 class="cs-category-title" id="first-year-scholars-title">First-Year Scholars</h3>
                <p class="cs-scholars-note">The First-Year Scholars Program pairs first-year students who are interested in research with mentors to engage in an academic year-long research project.</p>
            </div>
            {[...firstYearCohorts].sort((a, b) => b.year - a.year).map((cohort) => (
                <section class="cs-scholar-cohort" aria-labelledby={`scholars-${cohort.year}`}>
                    <div class="cs-cohort-header">
                        <h4 class="cs-cohort-year" id={`scholars-${cohort.year}`}>{cohort.year}</h4>
                        <p class="cs-cohort-mentor">Research Mentor: <a href={cohort.mentor.profile}>{cohort.mentor.name}</a></p>
                    </div>
                    <ul class="cs-card-group cs-card-group-scholars">
                        {cohort.students.map((student) => (
                            <li class="cs-item cs-item-scholar">
                                {student.image ? (
                                    <picture class="cs-picture">
                                        <source media="(max-width: 600px)" srcset={student.image} />
                                        <source media="(min-width: 601px)" srcset={student.image} />
                                        <img loading="lazy" decoding="async" src={student.image} alt={student.name} width="305" height="338" />
                                    </picture>
                                ) : (
                                    <div class="cs-picture cs-picture-placeholder" role="img" aria-label={`${student.name} — photo coming soon`}>
                                        <span class="cs-initials" aria-hidden="true">{student.name.split(' ').map((part) => part[0]).join('')}</span>
                                    </div>
                                )}
                                <div class="cs-info">
                                    <span class="cs-name">{student.name}</span>
                                    {student.job && <span class="cs-job">{student.job}</span>}
                                    {student.interests && <span class="cs-interests">{student.interests}</span>}
                                    {student.profile ? (
                                        <a class="cs-bio-button" href={student.profile}>View Profile</a>
                                    ) : (
                                        <span class="cs-interests">Profile coming soon</span>
                                    )}
                                </div>
                            </li>
                        ))}
                    </ul>
                </section>
            ))}
        </section>

        <!-- Visiting Scholar Section -->
        <section class="cs-category-section" id="visiting-scholars" aria-labelledby="visiting-scholars-title">
            <div class="cs-category-header">
                <div class="cs-category-icon cs-icon-visiting">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M2 12h20M12 2a16 16 0 0 1 0 20 16 16 0 0 1 0-20z"></path>
                    </svg>
                </div>
                <h3 class="cs-category-title" id="visiting-scholars-title">Visiting Scholar</h3>
                <div class="cs-category-divider"></div>
            </div>
            <ul class="cs-card-group">
                {visitingScholars.map((scholar) => (
                    <li class="cs-item cs-item-visiting">
                        <picture class="cs-picture">
                            <source media="(max-width: 600px)" srcset={scholar.image} />
                            <source media="(min-width: 601px)" srcset={scholar.image} />
                            <img loading="lazy" decoding="async" src={scholar.image} alt={`${scholar.name} visiting the lab`} width="305" height="338" style={{ objectFit: scholar.imageFit, objectPosition: scholar.imagePosition }} />
                        </picture>
                        <div class="cs-info">
                            <span class="cs-name">{scholar.name}</span>
                            <span class="cs-job">Visiting Scholar</span>
                            <span class="cs-visit-institution">{scholar.institution}</span>
                        </div>
                    </li>
                ))}
            </ul>
        </section>

        <!-- Bottom Section Decoration -->
        <div class="cs-bottom-section">
            <div class="cs-bottom-card">
                <div class="cs-bottom-icon">🔬</div>
                <h3 class="cs-bottom-title">Join Our Team</h3>
                <p class="cs-bottom-text">Interested in biomechanics research? We're always looking for passionate students to join our lab.</p>
                <a href="/contact" class="cs-bottom-button">Apply Now</a>
            </div>
            <div class="cs-bottom-card cs-card-secondary">
                <div class="cs-bottom-icon">📊</div>
                <h3 class="cs-bottom-title">Research Impact</h3>
                <p class="cs-bottom-text">Our work has been published in top journals and presented at major conferences worldwide.</p>
                <a href="/publications" class="cs-bottom-button cs-button-outline">View Publications</a>
            </div>
            <div class="cs-bottom-card cs-card-tertiary">
                <div class="cs-bottom-icon">💡</div>
                <h3 class="cs-bottom-title">Collaborations</h3>
                <p class="cs-bottom-text">We collaborate with leading institutions including Emory University and Columbia University.</p>
                <a href="/contact" class="cs-bottom-button cs-button-outline">Get in Touch</a>
            </div>
        </div>

        <!-- Bottom Decorations -->
        <div class="cs-footer-decoration">
            <div class="cs-footer-wave"></div>
            <div class="cs-footer-circle cs-fc-1"></div>
            <div class="cs-footer-circle cs-fc-2"></div>
        </div>
    </div>
</section>

</BaseLayout>

<style lang="less">
  @import "../styles/pages/members.less";
</style>
